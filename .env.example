# Reference only. This server does not auto-load .env files.
# Configure real values in a secure server process environment, never in chat/Git.
# Blank values intentionally deny workflow access; ping remains public.
WFC_AUTH_TOKEN=
WFC_REVIEWER_ID=
# Optional absolute persistent SQLite path; default: project/data/workflow.sqlite3
WFC_DB_PATH=
# GitHub credentials: use existing authenticated gh credential store, not this file.

# POC-only unsafe bypass (off by default). Exposes ALL seven workflow APIs to
# anyone who can reach the Cloudflare URL. Never use with actual task data.
# To enable, set WFC_POC_NO_AUTH=1 AND an absolute WFC_DB_PATH whose filename is
# workflow-poc-unauth.sqlite3. Stop the tunnel and unset these after the test.
WFC_POC_NO_AUTH=
