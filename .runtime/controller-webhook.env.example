# Copy locally to .runtime/controller-webhook.env.
# No real credentials in this template.

WFC_CONTROLLER_INSTALLATION_ID=0

# PostgreSQL runtime connection.
# Replace host, port, username, password and database locally.
PG_RUNTIME_DSN=postgresql+psycopg://webhook_user:CHANGE_ME@postgres-host:5432/workflow

# Webhook HMAC secret must be stored in:
# .secret/controller-webhook-secret (32+ bytes).
