# Copy to .runtime/mcp.env (this file is never committed).
# Use a NEW disposable Docker volume. Do not copy your Windows SQLite database here.
WFC_DB_PATH=/state/workflow-poc-unauth.sqlite3
# Default denies anonymous access to all seven workflow tools.
# Set to 1 ONLY while testing synthetic data and explicitly accepting public exposure.
WFC_POC_NO_AUTH=0
# Optional protected mode credentials; never paste tokens in chat or commit files.
WFC_AUTH_TOKEN=
WFC_REVIEWER_ID=
