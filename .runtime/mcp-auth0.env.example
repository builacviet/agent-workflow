# Copy to an ignored local .runtime/mcp-auth0.env; never commit actual values.
# Auth0 resource-server mode is opt-in. Static bearer remains the default.
WFC_AUTH_MODE=auth0
WFC_AUTH0_ISSUER=https://YOUR-TENANT.us.auth0.com/
WFC_AUTH0_ALLOWED_SUB=
WFC_AUTH0_CLIENT_ID=
WFC_AUTH0_SCOPE=wfc:workflow
WFC_PUBLIC_HOST=caddy-reopen-scotch.ngrok-free.dev
WFC_POC_NO_AUTH=0
# WFC_DB_PATH=/state/workflow.sqlite3
