# V1 Controller stack MCP: copy to .runtime/controller-mcp.env (Git-ignored).
# The Controller + MCP + webhook share the same SQLite DB via Compose /state.
# This template intentionally defaults to Auth0 OAuth, the Owner's MCP mode.
# Copying alone is NOT enough: fill the values from your already-verified Auth0 setup.
# If they are missing, startup must fail closed. Never use WFC_POC_NO_AUTH=1.
WFC_AUTH_MODE=auth0
WFC_POC_NO_AUTH=0

# Auth0 resource-server identity (no token/password belongs in this template).
WFC_AUTH0_ISSUER=
WFC_AUTH0_ALLOWED_SUB=
WFC_OAUTH_EXPECTED_CLIENT_ID=
WFC_AUTH0_SCOPE=wfc:workflow
WFC_AUTH0_DIAGNOSTICS=0

# Optional: gate reviewer workflow on Controller-verified exact-HEAD CI.
# Enable on EVERY trusted process that can use reviewer workflow APIs.
# WFC_CI_GATE_REQUIRED=1

# Legacy local static Bearer ONLY: explicitly switch WFC_AUTH_MODE=bearer
# and uncomment BOTH lines; token must be at least 32 random characters.
# WFC_AUTH_TOKEN=
# WFC_REVIEWER_ID=

# WFC_PUBLIC_HOST is set by compose.controller.yaml from NGROK_DOMAIN.
# WFC_DB_PATH is set by compose.controller.yaml to /state/workflow.sqlite3.
# See .runtime/README.md for active vs legacy config file ownership.
