# Copy to controller-mcp.env; set locally, never in chat or Git.
# Controller JSON and MCP must use the same App/installation and host SQLite file.
WFC_GITHUB_APP_ID=
WFC_GITHUB_INSTALLATION_ID=
WFC_AUTH_TOKEN=
WFC_REVIEWER_ID=
# Set an operator-owned public hostname only if a separately authorized tunnel is used.
WFC_PUBLIC_HOST=
