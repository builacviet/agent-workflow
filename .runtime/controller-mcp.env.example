# Copy locally to .runtime/controller-mcp.env; do not commit secrets.
# The Phase 3.1 Controller and MCP must share the exact same SQLite file.
# Choose one authentication mode (default bearer preserves the legacy behavior).
WFC_AUTH_MODE=bearer
WFC_POC_NO_AUTH=0

# Legacy static Bearer mode only:
WFC_AUTH_TOKEN=
WFC_REVIEWER_ID=

# Auth0 OAuth mode: set WFC_AUTH_MODE=auth0 and fill the fields below.
# A dedicated Auth0 tenant + custom API identifier must match the public /mcp URL.
# CIMD client is pre-registered in Auth0; DCR stays disabled.
# Resource Parameter Compatibility Profile must be enabled.
WFC_AUTH0_ISSUER=
WFC_AUTH0_ALLOWED_SUB=
# Exact ChatGPT CIMD metadata URL; e.g. https://chatgpt.com/oauth/client.json
# Not necessarily Auth0's internal tpc_ application record ID.
WFC_OAUTH_EXPECTED_CLIENT_ID=
# Temporary troubleshooting only; prints fixed reason codes without token data.
# Leave 0 in normal operation and turn back off immediately after one test.
WFC_AUTH0_DIAGNOSTICS=0
WFC_AUTH0_SCOPE=wfc:workflow
WFC_PUBLIC_HOST=
