# Copy locally to .runtime/controller-mcp.env; do not commit secrets.
# The Phase 3.1 Controller and MCP must share the exact same SQLite file.
# Choose one authentication mode (default bearer preserves the legacy behavior).
WFC_AUTH_MODE=bearer
WFC_POC_NO_AUTH=0

# Legacy static Bearer mode only:
WFC_AUTH_TOKEN=
WFC_REVIEWER_ID=

# Auth0 OAuth mode: set WFC_AUTH_MODE=auth0 and fill the fields below.
# A dedicated Auth0 tenant + custom API identifier must match the public /mcp URL.
# DCR and Resource Parameter Compatibility Profile require operator opt-in.
WFC_AUTH0_ISSUER=
WFC_AUTH0_ALLOWED_SUB=
WFC_AUTH0_SCOPE=wfc:workflow
WFC_PUBLIC_HOST=
