# V1 Controller stack MCP: copy to .runtime/controller-mcp.env (Git-ignored).
# The Controller + MCP + webhook share the same SQLite DB via Compose /state.
# This template intentionally defaults to Auth0 OAuth, the Owner's MCP mode.
# Copying alone is NOT enough: fill the values from your already-verified Auth0 setup.
# If they are missing, startup must fail closed.
WFC_AUTH_MODE=auth0

# Auth0 resource-server identity (no token/password belongs in this template).
WFC_AUTH0_ISSUER=
WFC_AUTH0_ALLOWED_SUB=
WFC_OAUTH_EXPECTED_CLIENT_ID=
WFC_AUTH0_SCOPE=wfc:workflow
WFC_AUTH0_DIAGNOSTICS=0

# Optional: gate reviewer workflow on Controller-verified exact-HEAD CI.
# Enable on EVERY trusted process that can use reviewer workflow APIs.
# WFC_CI_GATE_REQUIRED=1

# Legacy local static Bearer ONLY: explicitly switch WFC_AUTH_MODE=bearer
# and uncomment BOTH lines; token must be at least 32 random characters.
# WFC_AUTH_TOKEN=
# WFC_REVIEWER_ID=

# WFC_PUBLIC_HOST is set by compose.yaml from NGROK_DOMAIN.
# WFC_DB_PATH is set by compose.yaml to /state/workflow.sqlite3.
# See .runtime/README.md for active vs legacy config file ownership.

# Optional dedicated Tech Lead identities; blank IDs keep integrations disabled.
# Owner fills verified nonsecret IDs only in the ignored runtime file.
# Numeric GitHub examples: App ID 123456, installation ID 234567, bot ID 345678.
TECHLEAD_GITHUB_APP_ID=
TECHLEAD_GITHUB_INSTALLATION_ID=
# Example slug: example-techlead (without [bot]).
TECHLEAD_GITHUB_APP_SLUG=
TECHLEAD_GITHUB_BOT_ID=
TECHLEAD_GITHUB_KEY_FILE=/run/secrets/wf-teamlead.pem
# Verified Notion bot UUID; example format: 00000000-0000-4000-8000-000000000001.
TECHLEAD_NOTION_BOT_ID=
TECHLEAD_NOTION_TOKEN_FILE=/run/secrets/notion-tl.token
# Never place PEM/token contents here. Owner activates the commented Compose mounts.
# TECHLEAD_SECRETS_DIR belongs to the host shell/root .env, not this env_file.
